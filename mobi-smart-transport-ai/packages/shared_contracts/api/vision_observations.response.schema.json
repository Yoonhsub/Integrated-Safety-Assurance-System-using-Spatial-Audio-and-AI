        "cameraId": {
          "title": "Cameraid",
          "type": "string"
        },
        "producerId": {
          "title": "Producerid",
          "type": "string"
        },
        "sessionId": {
          "title": "Sessionid",
          "type": "string"
        },
        "cameraEpoch": {
          "format": "uuid",
          "title": "Cameraepoch",
