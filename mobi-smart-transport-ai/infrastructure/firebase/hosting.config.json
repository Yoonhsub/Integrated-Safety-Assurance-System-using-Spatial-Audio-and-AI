{
  "hosting": {
    "site": "mobi-smart-transport",
    "public": "web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {"source": "/passenger", "destination": "/passenger/", "type": 302},
      {"source": "/driver", "destination": "/driver/", "type": 302}
    ],
    "rewrites": [
      {"source": "/passenger/**", "destination": "/passenger/index.html"},
      {"source": "/driver/**", "destination": "/driver/index.html"}
    ],
    "headers": [
      {"source": "**", "headers": [
        {"key": "Cache-Control", "value": "no-cache"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]}
    ]
  }
}
